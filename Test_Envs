
import numpy as np
import time

from dmrg.mps import product_state
from dmrg.tfim import tfim_mpo
from dmrg.sweep import sweep

# Parameters
L = 200
J = 1.0
h = 1.0
bond_dims = [4, 8, 16]
number_of_sweeps = 5

mpo = tfim_mpo(L, J, h)

# Run benchmarks
for chi in bond_dims:

    # Fresh MPS for each run
    mps = product_state([1.0, 0.0], L)

    start = time.perf_counter()

    final_mps, ground_energy = sweep(
        mps, mpo,
        bond_dim=chi,
        number_of_sweeps=number_of_sweeps,
        tol=0
    )

    elapsed = time.perf_counter() - start

    print(f"\nBond dimension: {chi}")
    print(f"Ground energy:  {ground_energy:.12f}")
    print(f"Runtime:        {elapsed:.2f} seconds")
    print("-" * 40)
